      <string>com.apple.syncservices.RecordEntityName</string>
      <string>first name</string><string>last name</string>
      <string>middle name</string><string>title</string><string>suffix</string>
      <string>nickname</string><string>company name</string>
      <string>display as company</string>
      <string>department</string><string>job title</string>
